{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "data": "node ../scripts/build-data.mjs",
    "validate:data": "node ../scripts/validate-data.mjs --strict",
    "test:data": "node --test ../scripts/tests/validate-data.test.mjs",
    "prestart": "npm run validate:data && npm run data",
    "start": "ng serve",
    "prebuild": "npm run validate:data && npm run data",
    "build": "ng build",
    "verify:dist": "node ../scripts/verify-dist.mjs",
    "build:ci": "npm run build -- --configuration production && npm run verify:dist",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run validate:data && npm run data",
    "test": "ng test",
    "test:ci": "npm test -- --watch=false",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "audit:links": "node ../scripts/check-external-links.mjs",
    "check": "npm run validate:data && npm run test:data && npm run audit:prod && npm run audit:dependencies && npm run test:ci && npm run build:ci",
    "serve:ssr:app": "node dist/app/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-server": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/ssr": "^21.2.20",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "undici": "7.29.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.1.0"
  }
}
