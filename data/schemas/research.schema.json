{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-patterns.dev/schemas/research.schema.json",
  "title": "PatternResearch",
  "description": "Shared shape for the files under data/patterns/<id>/research/*.json. Each file holds one critical research dimension on that pattern.",
  "oneOf": [
    {
      "title": "OpinionatedResearch",
      "description": "critique.json, counter-arguments.json — a stance plus a list of bullet points.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stance", "summary", "points"],
      "properties": {
        "stance":  { "type": "string", "enum": ["supports", "challenges", "mixed", "unknown"] },
        "summary": { "type": "string", "minLength": 1 },
        "points":  {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text":      { "type": "string", "minLength": 1 },
              "severity":  { "type": "string", "enum": ["info", "note", "warning", "blocker"] },
              "source_id": { "type": "string", "pattern": "^s[1-9][0-9]*$", "description": "Optional reference to data/sources/<id>/." }
            }
          }
        }
      }
    },
    {
      "title": "ItemList",
      "description": "tools.json, extensions.json, sources.json — a summary plus a list of cross-references.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "items"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text":       { "type": "string", "minLength": 1 },
              "ref_type":   { "type": "string", "enum": ["tool", "pattern", "source", "concept", "external"] },
              "ref_id":     { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Id within the chosen ref_type's folder." },
              "url":        { "type": "string", "format": "uri", "pattern": "^https://", "description": "External URL when ref_type = external." }
            },
            "allOf": [
              {
                "if": {
                  "required": ["ref_type"],
                  "properties": { "ref_type": { "const": "external" } }
                },
                "then": {
                  "required": ["url"],
                  "not": { "required": ["ref_id"] }
                }
              },
              {
                "if": {
                  "required": ["ref_type"],
                  "properties": { "ref_type": { "enum": ["tool", "pattern", "source", "concept"] } }
                },
                "then": {
                  "required": ["ref_id"],
                  "not": { "required": ["url"] }
                }
              },
              {
                "if": { "not": { "required": ["ref_type"] } },
                "then": {
                  "not": {
                    "anyOf": [
                      { "required": ["ref_id"] },
                      { "required": ["url"] }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
