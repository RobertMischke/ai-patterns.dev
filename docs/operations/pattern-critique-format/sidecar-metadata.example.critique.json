      "id": "PC-0041",
      "type": "counter-argument",
      "claim": "Separate files improve visibility but weaken atomic portability: ordinary file moves, copies, downloads, and patches can silently omit the metadata.",
      "grounding": [
        {
          "kind": "external",
          "ref": "https://reuse.software/spec/",
          "summary": "REUSE uses companion .license files for content that cannot carry comments, illustrating both the established convention and the need for sidecar-aware tooling."
        },
        {
          "kind": "repository",
          "ref": "data/patterns/sidecar-metadata/research/counter-arguments.json",
          "summary": "The pattern research explicitly identifies accidental separation during moves or copies as a trade-off."
        }
      ],
      "status": "addressed",
      "rating": {
